{
  "name": "apexcharts-card",
  "version": "2.2.3",
  "type": "module",
  "description": "A Home Assistant Lovelace card using ApexCharts to render graphs",
  "main": "src/apexcharts-card.ts",
  "scripts": {
    "build": "npm run build:types-check && npm run lint && npm run rollup",
    "build:types-check": "ts-interface-builder src/types-config.ts",
    "rollup": "rollup -c",
    "lint": "eslint src/*.ts",
    "watch": "npm run build:types-check && rollup -c --watch",
    "postversion": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RomRider/apexcharts-card.git"
  },
  "keywords": [
    "lovelace",
    "apexcharts",
    "graphs",
    "charts",
    "home-assistant"
  ],
  "author": "Jérôme Wiedemann",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/RomRider/apexcharts-card/issues"
  },
  "homepage": "https://github.com/RomRider/apexcharts-card#readme",
  "dependencies": {
    "@ctrl/tinycolor": "^4.2.0",
    "@material/mwc-ripple": "^0.27.0",
    "apexcharts": "^6.3.0",
    "array-flat-polyfill": "^1.0.1",
    "custom-card-helpers": "^1.9.0",
    "lit": "^3.3.2",
    "localforage": "^1.10.0",
    "lz-string": "^1.5.0",
    "moment": "^2.30.1",
    "moment-duration-format": "^2.3.2",
    "moment-range": "^4.0.2",
    "moment-timezone": "^0.6.0",
    "parse-duration": "^2.1.5",
    "spark-md5": "^3.0.2",
    "ts-interface-checker": "^1.0.2"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@babel/preset-env": "^7.29.0",
    "@babel/preset-typescript": "^7.28.5",
    "@rollup/plugin-babel": "^7.0.0",
    "@rollup/plugin-commonjs": "^29.0.2",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/npm": "^12.0.2",
    "@semantic-release/release-notes-generator": "^14.1.0",
    "@types/moment-duration-format": "^2.2.7",
    "@types/node": "^25.4.0",
    "@types/spark-md5": "^3.0.5",
    "@typescript-eslint/eslint-plugin": "^8.57.0",
    "@typescript-eslint/parser": "^8.57.0",
    "conventional-changelog-conventionalcommits": "^9.3.0",
    "eslint": "^9.39.4",
    "home-assistant-js-websocket": "^9.6.0",
    "rollup-plugin-serve": "^3.0.0",
    "rollup-plugin-typescript2": "^0.36.0",
    "semantic-release": "^24.2.9",
    "ts-interface-builder": "^0.3.3",
    "typescript": "^5.9.3"
  }
}
